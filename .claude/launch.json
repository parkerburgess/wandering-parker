{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wandering-parker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "wandering-parker-noauth",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3000"],
      "env": { "DISABLE_AUTH": "true" },
      "port": 3000
    },
    {
      "name": "auth-service",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../auth-wandering-parker", "run", "dev"],
      "port": 3001,
      "autoPort": false
    }
  ]
}
